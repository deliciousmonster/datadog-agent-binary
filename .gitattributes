# Normalize line endings to LF in the working tree on every platform.
# Without this, Windows CI checks files out as CRLF and `prettier --check`
# (endOfLine: "lf") flags every file.
* text=auto eol=lf

# Shell scripts and the Node bin shims must stay LF to run. Both launchers, not just
# the core agent's: an extensionless CRLF script fails at the shebang.
*.sh text eol=lf
bin/* text eol=lf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.tgz binary
*.zip binary
