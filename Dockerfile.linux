# Cross-compile the Datadog Agent to Linux.
FROM golang:1.23

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    make \
    gcc \
    gcc-aarch64-linux-gnu \
    gcc-x86-64-linux-gnu \
    libc6-dev \
    libc6-dev-arm64-cross \
    libc6-dev-amd64-cross \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV CGO_ENABLED=1
ENV GOOS=linux

# Source and build script are mounted at runtime.
WORKDIR /workspace

CMD ["/bin/bash"]
