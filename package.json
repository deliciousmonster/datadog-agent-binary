{
	"name": "@harperfast/datadog-agent-binary",
	"version": "7.75.5",
	"description": "Harper component that runs the Datadog trace-agent and core-agent alongside a node, with pre-built binaries installed per platform",
	"type": "module",
	"bin": {
		"datadog-agent": "bin/datadog-agent"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/src/cli.js",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist/ build/ release/ source/ go/ npm/",
		"build-agent": "npm run build && node dist/src/cli.js build",
		"all-platform-packages": "npm run build && node scripts/create-platform-packages.js --all",
		"platform-package": "npm run build && npm run build-agent && node scripts/create-platform-packages.js",
		"update-optional-deps": "npm run build && node scripts/update-optional-deps.js",
		"verify-package": "npm run build && node scripts/verify-package.js",
		"lint": "prettier --write .",
		"lint:check": "prettier --check .",
		"prepare": "husky",
		"version": "npm run build && npm run update-optional-deps",
		"test": "npm run build && node --test \"test/component/**/*.test.js\" \"test/e2e/**/*.test.js\"",
		"test:live": "npm run build && node --test \"test/live/**/*.test.js\""
	},
	"keywords": [
		"datadog",
		"agent",
		"build",
		"cross-platform"
	],
	"author": "",
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/node": "^26.0.0",
		"commander": "^15.0.0",
		"dd-trace": "^6.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2"
	},
	"files": [
		"bin/",
		"conf.d/",
		"config.yaml",
		"resources.js",
		"runtime/",
		"guard/src/",
		"guard/package.json",
		"README.md"
	],
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/datadog-agent-binary.git"
	},
	"bugs": {
		"url": "https://github.com/HarperFast/datadog-agent-binary/issues"
	},
	"homepage": "https://github.com/HarperFast/datadog-agent-binary#readme",
	"optionalDependencies": {
		"@harperfast/datadog-agent-binary-linux-x86_64": "7.75.5",
		"@harperfast/datadog-agent-binary-linux-arm64": "7.75.5",
		"@harperfast/datadog-agent-binary-macos-arm64": "7.75.5",
		"@harperfast/datadog-agent-binary-windows-x86_64": "7.75.5"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"prettier --check"
		]
	}
}
