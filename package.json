{
	"name": "@deliciousmonster/datadog-agent-binary",
	"version": "7.75.5",
	"description": "Distributes the pre-compiled Datadog Agent as an npm package, so the agent is installed and versioned as a normal Node dependency instead of through a system package manager or a container sidecar. Intended for running the agent alongside a Node application, including inside Harper v5.",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"datadog-agent-build": "dist/cli.js",
		"datadog-agent": "bin/datadog-agent",
		"datadog-trace-agent": "bin/trace-agent"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json --noEmit",
		"clean": "rm -rf dist/ build/ release/ source/ go/ npm/",
		"build-agent": "npm run build && node dist/cli.js build",
		"all-platform-packages": "npm run build && node scripts/create-platform-packages.js --all",
		"platform-package": "npm run build && npm run build-agent && node scripts/create-platform-packages.js",
		"update-optional-deps": "npm run build && node scripts/update-optional-deps.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint",
		"prepare": "husky",
		"version": "npm run build && npm run update-optional-deps",
		"prepublishOnly": "npm run build",
		"test": "npm run build && node --test \"test/**/*.test.js\"",
		"test:integration": "npm run build && harper-integration-test-run --isolation=none \"test/integration/**/*.test.ts\"",
		"matrix": "npm run build && node scripts/publish-matrix.js --registry",
		"matrix:local": "npm run build && node scripts/publish-matrix.js --local"
	},
	"keywords": [
		"datadog",
		"agent",
		"build",
		"cross-platform"
	],
	"author": "",
	"license": "Apache-2.0",
	"dependencies": {
		"commander": "^11.1.0",
		"tar": "^6.2.0"
	},
	"devDependencies": {
		"@harperfast/integration-testing": "^0.7.1",
		"@types/node": "^20.10.0",
		"@types/tar": "^6.1.10",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"oxlint": "1.78.0",
		"prettier": "^3.6.1",
		"tsx": "^4.7.0",
		"typescript": "^5.3.0"
	},
	"files": [
		"dist/",
		"bin/",
		"conf.d/",
		".datadog-agent-version",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperFast/datadog-agent-binary.git"
	},
	"bugs": {
		"url": "https://github.com/HarperFast/datadog-agent-binary/issues"
	},
	"homepage": "https://github.com/HarperFast/datadog-agent-binary#readme",
	"optionalDependencies": {
		"@deliciousmonster/datadog-agent-binary-linux-arm64": "7.75.5",
		"@deliciousmonster/datadog-agent-binary-linux-x86_64": "7.75.5",
		"@deliciousmonster/datadog-agent-binary-macos-arm64": "7.75.5",
		"@deliciousmonster/datadog-agent-binary-windows-x86_64": "7.75.5"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"prettier --check"
		]
	}
}
