# Dependencies. Each pattern is listed twice: git matches a trailing slash against
# directories only, and a worktree commonly satisfies these by symlinking them at a
# shared copy, which the slashed form leaves untracked and stageable by `git add -A`.
node_modules/
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
dist
build/
build
release/
npm/
*.tgz

# Source downloads
source/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
/go

# Regenerated by the documented `npm install` step in example/README.md.
example/package-lock.json
