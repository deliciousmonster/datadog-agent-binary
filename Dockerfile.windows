# Cross-compile the Datadog Agent to Windows.
FROM golang:1.23

RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    make \
    gcc \
    mingw-w64 \
    mingw-w64-tools \
    gcc-mingw-w64-x86-64 \
    gcc-mingw-w64-i686 \
    binutils-mingw-w64-x86-64 \
    binutils-mingw-w64-i686 \
    pkg-config \
    cmake \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CGO_ENABLED=1
ENV GOOS=windows

# Source and build script are mounted at runtime.
WORKDIR /workspace

CMD ["/bin/bash"]
