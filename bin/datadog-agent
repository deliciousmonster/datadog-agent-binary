#!/usr/bin/env node

import { spawn } from "node:child_process";

import { describeExit, describeSpawnFailure } from "../runtime/agent-exit.js";
import { resolveBinary } from "../runtime/binary.js";
import { logger } from "../runtime/log.js";

// The core agent, in the shape the resolver reads. The shim launches this one; the component launches both.
const CORE_AGENT = { shipsAs: "datadog-agent", title: "core agent" };

// Report which Datadog-relevant environment variables are visible to this
// process. The agent disables itself (or silently collects nothing) when its
// API key / site are missing, so confirming what actually reached the process
// is the first thing to check when "no logs are flowing".
function logDatadogEnv() {
	const present = (name) => (process.env[name] ? "set" : "MISSING");
	logger.info(
		"Datadog env visible to wrapper: " +
			`DD_API_KEY=${present("DD_API_KEY")}, ` +
			`DD_SITE=${process.env.DD_SITE || "MISSING"}, ` +
			`DD_ENV=${process.env.DD_ENV || "MISSING"}, ` +
			`DD_HOSTNAME=${process.env.DD_HOSTNAME || "(default)"}, ` +
			`DD_LOGS_ENABLED=${process.env.DD_LOGS_ENABLED || "(unset, default false)"}, ` +
			`DD_LOG_TO_CONSOLE=${process.env.DD_LOG_TO_CONSOLE || "(unset, default true)"}`
	);
	// Both remedies are the environment, never a file: the component regenerates its datadog.yaml on every
	// worker start (runtime/config.js), and this shim ships with no datadog.yaml of its own to edit.
	if (!process.env.DD_API_KEY) {
		logger.warn(
			"DD_API_KEY is not set in this process. The agent will start and collect, but " +
				"the intake rejects the payloads, so nothing will appear in Datadog under " +
				`env:${process.env.DD_ENV || "<DD_ENV is unset too>"} or any other. Export ` +
				"DD_API_KEY into this process; the key never goes on disk."
		);
	}
	if (!process.env.DD_LOGS_ENABLED) {
		logger.warn(
			"DD_LOGS_ENABLED is not set (defaults to false). Log collection is OFF, so " +
				"application logs will not be forwarded to Datadog even when the agent is " +
				"running. Export DD_LOGS_ENABLED=true into this process and configure a logs source."
		);
	}
}

async function main() {
	const args = process.argv.slice(2);
	try {
		logDatadogEnv();

		const binaryPath = await resolveBinary(CORE_AGENT);

		logger.info(
			`Spawning datadog-agent: ${binaryPath} ${args.join(" ")} ` +
				`(cwd=${process.cwd()})`
		);

		// Harper v5 requires `name` on spawn options when invoked from inside a
		// Harper application — it lets Harper dedupe the child across worker
		// threads. The option is silently ignored by stock Node.js, so this is
		// safe outside Harper too.
		const child = spawn(binaryPath, args, {
			stdio: "inherit",
			env: process.env,
			name: "datadog-agent",
		});

		logger.info(`datadog-agent child process started (pid=${child.pid})`);

		child.on("exit", (code, signal) => {
			// A signalled child reports no exit code, so `code || 0` hands a caller 0 for an OOM kill.
			const { killed, detail, exitCode } = describeExit(code, signal);
			if (killed) logger.error(`datadog-agent ${detail}`);
			else if (exitCode !== 0) logger.warn(`datadog-agent ${detail}`);
			else logger.info(`datadog-agent ${detail}`);
			process.exit(exitCode);
		});

		child.on("error", (error) => {
			// Under Harper v5 spawn enforcement, a binary path that is not listed
			// in applications.allowedSpawnCommands surfaces here as an error.
			logger.error(
				`datadog-agent could not run: ${describeSpawnFailure(error, binaryPath)}`
			);
			logger.error(
				`If running under Harper, confirm this exact absolute path is in ` +
					`applications.allowedSpawnCommands: ${binaryPath}`
			);
			process.exit(1);
		});
	} catch (error) {
		logger.error(`Failed to run datadog-agent: ${error.message}`);
		// The source-build CLI is not published, so a customer reading this has one thing to check.
		logger.info(
			"The binary comes from an optionalDependency. Confirm one of " +
				"@harperfast/datadog-agent-binary-<platform> is installed for this os/cpu."
		);
		process.exit(1);
	}
}

main();
