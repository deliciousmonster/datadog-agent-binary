#!/usr/bin/env node

// All launcher behaviour (env diagnostics, preflight checks, Harper spawn semantics)
// lives in dist/agent-launcher.js so the core-agent and trace-agent launchers cannot
// drift apart. Dynamic import(), not a static one: this file has no extension, so Node
// may parse it as CommonJS, and import() is the one form that loads the ESM launcher
// from either format.
import('../dist/agent-launcher.js').then((launcher) => launcher.launchAgent('core'));
